<Window x:Class="DE.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DE"
        mc:Ignorable="d"
        Title="AuthWindow" Height="350" Width="400">
    <Grid>
        <TextBox x:Name="loginBox" HorizontalAlignment="Left" Margin="132,56,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" Height="40"/>
        <TextBox x:Name="passwordBox" HorizontalAlignment="Left" Margin="132,117,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" Height="50"/>
        <Label Content="Логин" HorizontalAlignment="Left" Margin="148,34,0,0" VerticalAlignment="Top"/>
        <Label Content="Пароль" HorizontalAlignment="Left" Margin="148,96,0,0" VerticalAlignment="Top"/>
        <Button x:Name="loginButton" Content="Войти" HorizontalAlignment="Left" Margin="132,199,0,0" VerticalAlignment="Top" Height="55" Width="114" Click="Button_Click"/>
    </Grid>
</Window>
